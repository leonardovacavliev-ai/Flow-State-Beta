# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Google Account Authentication
# Client ID is public by design (it identifies the app to Google).
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# Signs our session tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ SECRET — never commit the real value.
SECRET_KEY=your_random_secret_here
# Only accounts on this domain get admin access.
ADMIN_EMAIL_DOMAIN=yotpo.com
# How long a sign-in lasts before the user must sign in again.
SESSION_TOKEN_DAYS=7

# Admin Configuration
# ⚠️ CHANGE THIS IN PRODUCTION!
ADMIN_PASSWORD=your_secure_admin_password_here

# Break-glass admin access. Leave 'false'. Set to 'true' only if Google
# sign-in breaks and you are locked out of the admin panel; every use is
# logged. Turn it back off once Google auth works again.
ADMIN_PASSWORD_FALLBACK=false

# Vector Database Configuration
# Switch between 'chromadb' (local) and 'pinecone' (cloud)
VECTOR_DB_PROVIDER=pinecone

# ChromaDB (local development only)
CHROMA_PERSIST_DIR=./chroma_db

# Pinecone (cloud deployment - REQUIRED for production)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=esp-loyalty-docs1
PINECONE_ENVIRONMENT=us-east-1

# Analytics Database Configuration
# Switch between 'sqlite' (local) and 'postgres' (cloud)
DATABASE_PROVIDER=postgres

# PostgreSQL (cloud deployment - REQUIRED for production)
DATABASE_URL=postgresql://user:password@host:port/database

# Session Store Configuration
# Switch between 'memory' (local) and 'redis' (cloud)
SESSION_PROVIDER=redis

# Redis (cloud deployment - REQUIRED for production)
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800

# Application Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5001

# Async Crawl Configuration (Phase 5)
# Set to 'true' to enable async background job crawling
USE_ASYNC_CRAWL=true

# Number of concurrent worker threads for crawling
# Low volume: 2, Medium: 3 (default), High volume: 5
CRAWL_WORKER_THREADS=3

# Platform-mechanics query cache (seconds). This second retrieval query does
# not depend on the user's message, so its result is memoized per ESP.
# Explicitly cleared whenever an ESP is re-vectorized; this TTL only bounds
# staleness from per-URL admin edits. Default 900 (15 min).
MECHANICS_CACHE_TTL_SECONDS=900

# Retrieval Debugging
# Set to 1 to log, per request: both retrieval queries, and the chunk ids,
# scores and source filenames each returned. Needed to tell a reasoning
# failure apart from a retrieval failure. Verbose - leave off in production.
RETRIEVAL_DEBUG=0

# Sampling Temperature
# Leave UNSET in production: each provider keeps its existing behavior
# (OpenAI 0.7, Claude and Gemini use their own defaults).
# Set to 0 when running evals, so before/after comparisons measure the change
# rather than sampling noise.
# AI_TEMPERATURE=0
